{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.rendobar/mcp",
  "title": "Rendobar",
  "description": "Serverless media processing: FFmpeg jobs, timeline composition, captions, and compression.",
  "websiteUrl": "https://rendobar.com/docs/mcp/",
  "repository": {
    "url": "https://github.com/rendobar/mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://rendobar.com/docs/_mintlify/favicons/rendobar/hAz85wJLG3Ql27TF/_generated/favicon/android-chrome-192x192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    }
  ],
  "version": "1.7.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@rendobar/mcp",
      "version": "1.7.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RENDOBAR_API_KEY",
          "description": "Rendobar API key (starts with 'rb_'). Get one at https://app.rendobar.com/settings/api-keys. The server starts without it so tools can be listed, but tool calls require it.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.rendobar.com/mcp"
    }
  ]
}
