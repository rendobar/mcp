{
  "name": "@rendobar/mcp",
  "version": "1.11.1",
  "type": "module",
  "license": "MIT",
  "description": "Rendobar: serverless media processing and generation for AI agents. Transform video, audio and images with FFmpeg, compose from a timeline, burn captions and compress to a budget. Generate and edit images from a text prompt, and upscale on a diffusion model.",
  "homepage": "https://rendobar.com/docs/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/rendobar/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/rendobar/mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "rendobar",
    "ai",
    "agent",
    "claude",
    "cursor",
    "video",
    "ffmpeg",
    "image-generation",
    "captions",
    "transcode",
    "video-editing"
  ],
  "author": "Rendobar",
  "bin": {
    "rendobar-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "smoke": "node dist/bin.js --version",
    "inspector": "npx -y @modelcontextprotocol/inspector node dist/bin.js",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@posthog/mcp": "^0.10.0",
    "@rendobar/sdk": "^5.0.0",
    "posthog-node": "^5.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "jiti": "^2.7.0",
    "msw": "^2.14.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "mcpName": "com.rendobar/mcp"
}
